# 複製為 .env.local 後填入本機值。真實密鑰不要提交。
# 會進瀏覽器的變數必須以 NEXT_PUBLIC_ 開頭。
# 見：node_modules/next/dist/docs/01-app/02-guides/environment-variables.md

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Payload CMS ──
# 本地 PostgreSQL 連線字串：postgres://帳號[:密碼]@主機:埠號/資料庫名
DATABASE_URI=postgres://raykai47@127.0.0.1:5432/blue_dawn
# 任意長亂碼（至少 32 字元），可用 `openssl rand -hex 32` 產生
PAYLOAD_SECRET=請換成你自己的亂碼
